# Copy to `.env` and fill in. All variables are prefixed MECHFORGE_.

# Which model drives the agent: "anthropic" or "openai".
MECHFORGE_LLM_VENDOR=anthropic

# Anthropic
MECHFORGE_ANTHROPIC_API_KEY=
MECHFORGE_ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
MECHFORGE_OPENAI_API_KEY=
MECHFORGE_OPENAI_MODEL=gpt-4o

# Generation tuning
MECHFORGE_LLM_MAX_TOKENS=4096
MECHFORGE_LLM_TEMPERATURE=0.2
MECHFORGE_MAX_AGENT_STEPS=24

# CAD sandbox
# Wall-clock budget per build (heavy fillet/boolean chains are legitimately slow).
MECHFORGE_CAD_TIMEOUT_SECONDS=300
# CPU-time rlimit for the sandbox process.
MECHFORGE_CAD_CPU_SECONDS=600
# Virtual address-space (RLIMIT_AS) cap in MB. 0 = disabled (recommended): OCCT/numpy
# over-reserve virtual memory, so a low cap causes false OOM. Contain real memory with
# the container's cgroup limit instead (docker run --memory ...).
MECHFORGE_CAD_MEMORY_LIMIT_MB=0

# Rendering
MECHFORGE_RENDER_IMAGE_SIZE=768
MECHFORGE_RENDER_VIEWS=4

# Printability defaults (mm) — a common desktop FDM bed
MECHFORGE_BUILD_VOLUME_X_MM=220
MECHFORGE_BUILD_VOLUME_Y_MM=220
MECHFORGE_BUILD_VOLUME_Z_MM=250
MECHFORGE_MIN_WALL_THICKNESS_MM=0.8

# Storage (inside the container; mapped to ./data by docker-compose)
MECHFORGE_WORKSPACE_DIR=/data/workspace

# Live viewer base URL (as reachable from your machine; used by the open_viewer MCP tool)
MECHFORGE_VIEWER_URL=http://localhost:8091

# Logging
MECHFORGE_LOG_LEVEL=INFO
MECHFORGE_LOG_JSON=true
